ASSISTANT_NAME=
CLAUDE_CODE_OAUTH_TOKEN=
# Model gateway (package litellm, spec 6/23). Set both or neither: the gateway
# container holds the credential above, and every agent container gets only
# this virtual key. Compose refuses to start the instance while the key is
# empty and the package is installed.
MODEL_GATEWAY_URL=
MODEL_GATEWAY_KEY=
# Instance-wide default agent model when a group has no per-group override.
# Subscription models only (no usage-credit / 1M-context ids). Unset → opus.
# e.g. claude-opus-4-8 | claude-sonnet-4-6 | claude-haiku-4-5-20251001 | claude-fable-5
ARIZUKO_DEFAULT_MODEL=
MAX_CONCURRENT_CONTAINERS=3
# External shared ExtendDB server, reachable at the same HTTPS URL from host
# and containers. Set the URL, base64 PEM certificate and signing region before
# `arizuko store enroll`. Enrollment writes scoped pairs into env/<daemon>.env
# and env/operator.env. Keep the server administrator password outside the instance.
DYNAMODB_URL=
STORE_CA=
AWS_REGION=
# Host ports for routd (API_PORT), dashd (DASH_PORT) and davd (DAV_PORT) serve
# their callers. Only WEB_PORT (proxyd) faces the network. Deployed instances
# take them above 49000, one block per instance: krons 49200+, sloth 49300+.
API_PORT=8080
# AUTH_SECRET signs the web stack's HS256 session/refresh cookies (proxyd, webd).
# Generate: openssl rand -hex 32. The ES256 service tokens that authenticate
# daemon-to-daemon calls are provisioned per-daemon by `arizuko run`.
AUTH_SECRET=
# CIDR allowlist of upstream proxies permitted to set X-Forwarded-For.
# Comma-separated. Default 127.0.0.1/32 trusts only a same-host proxy.
TRUSTED_PROXIES=127.0.0.1/32
TELEGRAM_BOT_TOKEN=
WEB_PORT=5173
WEB_HOST=
